# Copy to .env.development / .env.production and adjust.
# Read by src/config/api.js: _DEV in `astro dev`, _PROD in `astro build`.

# Dev: '/api' routes through the Vite proxy in astro.config.mjs (bypasses CORS).
VITE_API_BASE_URL_DEV=/api
VITE_API_BASE_URL_PROD=https://api.destiny-ghost.com

# Local HTTPS via Caddy (npm run caddy:start) — wildcard cert from the API project.
# Use absolute paths; Caddy runs under sudo.
TLS_CERT_PATH=/path/to/destiny-ghost-api/security/_wildcard.destiny-ghost.com.pem
TLS_KEY_PATH=/path/to/destiny-ghost-api/security/_wildcard.destiny-ghost.com-key.pem
