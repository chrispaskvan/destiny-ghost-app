{
    "name": "modern-astro-site",
    "type": "module",
    "version": "0.0.11",
    "engines": {
        "node": ">=24.16"
    },
    "scripts": {
        "build": "astro build",
        "start:production": "node server.mjs",
        "dev:caddy": "USE_PROXY=true astro dev --host 0.0.0.0 --port 1101",
        "caddy:start": "sudo env $(grep -v '^#' .env.development | grep '^TLS_' | xargs) caddy start --config Caddyfile",
        "caddy:stop": "sudo caddy stop",
        "caddy:reload": "sudo env $(grep -v '^#' .env.development | grep '^TLS_' | xargs) caddy reload --config Caddyfile",
        "dev:https": "npm run caddy:start && npm run dev:caddy",
        "lint": "eslint --ext .js,.jsx,.astro src/",
        "lint:fix": "eslint --fix --ext .js,.jsx,.astro src/",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.7",
        "@astrojs/react": "^7.0.1",
        "astro": "^7.3.8",
        "compression": "^1.8.2",
        "express": "^5.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.3.3",
        "eslint": "^10.12.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-security": "^4.2.0",
        "globals": "^17.13.0",
        "tailwindcss": "^4.3.3"
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "^10"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "^10"
        }
    }
}
